LASTFM_API_KEY=your_lastfm_api_key_here
PORT=3000
# Set to 1 to serve only from backend/data/cache/snapshot.json and never call the network
NEXTTRACK_OFFLINE=0
# Days before a cached upstream response is refetched (stale entries are still served offline)
NEXTTRACK_CACHE_TTL_DAYS=30
# Milliseconds of MusicBrainz/Wikidata enrichment per request before remaining candidates use tags only
NEXTTRACK_ENRICH_BUDGET_MS=25000
# HMAC secret for blind study trial ids; a dev default is used when unset
STUDY_SECRET=
# Allowed browser origin for CORS; any origin when unset
CORS_ORIGIN=
